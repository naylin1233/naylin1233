rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidRecapItem(data) {
      return data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128 &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 300 &&
             data.sourceType is string && data.sourceType in ['video', 'srt', 'text', 'youtube', 'tiktok'] &&
             (!('sourceUrl' in data) || data.sourceUrl == null || (data.sourceUrl is string && data.sourceUrl.size() <= 2000)) &&
             (!('originalText' in data) || data.originalText == null || (data.originalText is string && data.originalText.size() <= 200000)) &&
             data.myanmarSummary is string && data.myanmarSummary.size() <= 50000 &&
             data.myanmarScript is string && data.myanmarScript.size() <= 200000 &&
             (!('subtitlesSrt' in data) || data.subtitlesSrt == null || (data.subtitlesSrt is string && data.subtitlesSrt.size() <= 200000)) &&
             (!('voiceTone' in data) || data.voiceTone == null || (data.voiceTone is string && data.voiceTone in ['male_narrator', 'female_narrator', 'storyteller', 'energetic', 'calm', 'news_anchor'])) &&
             (!('speechSpeed' in data) || data.speechSpeed == null || (data.speechSpeed is number && data.speechSpeed >= 0.25 && data.speechSpeed <= 3.0)) &&
             (!('speechPitch' in data) || data.speechPitch == null || (data.speechPitch is number && data.speechPitch >= 0.25 && data.speechPitch <= 2.5)) &&
             (!('durationSeconds' in data) || data.durationSeconds == null || (data.durationSeconds is int && data.durationSeconds >= 0)) &&
             (!('updatedAt' in data) || data.updatedAt == null || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    match /users/{userId}/recaps/{recapId} {
      allow get, list: if isSignedIn() && request.auth.uid == userId;

      allow create: if isSignedIn() &&
                       request.auth.uid == userId &&
                       isValidId(recapId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll(['userId', 'title', 'sourceType', 'myanmarSummary', 'myanmarScript', 'createdAt']) &&
                       incoming().keys().hasOnly(['userId', 'title', 'sourceType', 'sourceUrl', 'originalText', 'myanmarSummary', 'myanmarScript', 'subtitlesSrt', 'voiceTone', 'speechSpeed', 'speechPitch', 'durationSeconds', 'createdAt', 'updatedAt']) &&
                       incoming().createdAt is timestamp &&
                       incoming().createdAt <= request.time &&
                       isValidRecapItem(incoming());

      allow update: if isSignedIn() &&
                       request.auth.uid == userId &&
                       isValidId(recapId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       isValidRecapItem(incoming()) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['title', 'sourceType', 'sourceUrl', 'originalText', 'myanmarSummary', 'myanmarScript', 'subtitlesSrt', 'voiceTone', 'speechSpeed', 'speechPitch', 'durationSeconds', 'updatedAt']);

      allow delete: if isSignedIn() && request.auth.uid == userId && isValidId(recapId);
    }
  }
}
